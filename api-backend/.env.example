# Copy to .env and fill in real values. The .env file is gitignored.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# rtc-backend integration
RTC_BASE_URL=http://localhost:8080
# Must equal rtc-backend's WS_PUBLISH_SECRET.
RTC_PUBLISH_SECRET=change-me-to-an-internal-secret

# App id — must match an app in rtc-backend's apps.json.
APP_ID=demo-app
# Path to the JSON apps file (see apps.example.json).
APPS_FILE=apps.json
